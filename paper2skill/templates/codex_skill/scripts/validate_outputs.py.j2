#!/usr/bin/env python
from __future__ import annotations

import argparse
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
REQUIRED = [
    "result.json",
    "qc/input_validation.json",
    "qc/environment_report.json",
    "qc/missing_dependencies.json",
    "qc/output_validation.json",
    "qc/qc_summary.json",
    "workflow/plan.json",
    "workflow/plan.md",
    "workflow/executed_steps.json",
    "parameters/resolved_parameters.json",
    "parameters/parameter_sources.json",
    "results/summary.json",
    "reproducibility/source_manifest.json",
    "reproducibility/algorithm_contract.yaml",
    "reproducibility/bio_contract.yaml",
    "reproducibility/environment_spec.yaml",
]


def write_json(path: Path, data: object) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--result", default=str(ROOT / "result"))
    args = parser.parse_args(argv)
    result = Path(args.result)
    missing = [rel for rel in REQUIRED if not (result / rel).exists() and rel != "qc/output_validation.json"]
    status = "pass" if not missing else "fail"
    output = {"status": status, "missing": missing}
    write_json(result / "qc" / "output_validation.json", output)
    print(json.dumps(output, indent=2))
    return 0 if status == "pass" else 2


if __name__ == "__main__":
    raise SystemExit(main())
