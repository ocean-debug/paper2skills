from __future__ import annotations

import json
import shutil
import subprocess
import sys
from pathlib import Path

import pytest


ROOT = Path(__file__).resolve().parents[1]
RESULT = ROOT / "result"
ENVIRONMENT_BLOCKED_STATUSES = {"blocked_runtime_missing", "blocked_dependencies_missing"}


def _load_json(path: Path) -> dict:
    if not path.exists():
        return {}
    return json.loads(path.read_text(encoding="utf-8"))


def _skip_if_environment_blocked() -> None:
    summary = _load_json(RESULT / "qc" / "qc_summary.json")
    status = summary.get("status")
    if status in ENVIRONMENT_BLOCKED_STATUSES:
        assert (RESULT / "qc" / "environment_report.json").exists()
        pytest.skip(f"demo environment unavailable: {status}")


def test_preflight_demo_passes():
    shutil.rmtree(RESULT, ignore_errors=True)
    result = subprocess.run(
        [sys.executable, str(ROOT / "scripts" / "preflight.py"), "--manifest", str(ROOT / "assets" / "demo_input_manifest.yaml"), "--out", str(RESULT)],
        text=True,
        capture_output=True,
        check=False,
    )
    if result.returncode == 2:
        _skip_if_environment_blocked()
    assert result.returncode == 0, result.stdout + result.stderr
    assert (RESULT / "qc" / "environment_report.json").exists()
