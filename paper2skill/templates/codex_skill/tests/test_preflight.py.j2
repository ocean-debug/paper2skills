from __future__ import annotations

import subprocess
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]


def test_preflight_demo_passes():
    result = subprocess.run(
        [sys.executable, str(ROOT / "scripts" / "preflight.py"), "--manifest", str(ROOT / "assets" / "demo_input_manifest.yaml"), "--out", str(ROOT / "result")],
        text=True,
        capture_output=True,
        check=False,
    )
    assert result.returncode == 0, result.stdout + result.stderr
    assert (ROOT / "result" / "qc" / "environment_report.json").exists()
