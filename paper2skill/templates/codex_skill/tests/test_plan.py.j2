from __future__ import annotations

import subprocess
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]


def test_plan_writes_workflow_plan():
    result = subprocess.run(
        [sys.executable, str(ROOT / "scripts" / "plan.py"), "--manifest", str(ROOT / "assets" / "demo_input_manifest.yaml"), "--out", str(ROOT / "result")],
        text=True,
        capture_output=True,
        check=False,
    )
    assert result.returncode == 0, result.stdout + result.stderr
    assert (ROOT / "result" / "workflow" / "plan.json").exists()
    assert (ROOT / "result" / "workflow" / "plan.md").exists()
