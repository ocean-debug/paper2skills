#!/usr/bin/env python
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(SCRIPT_DIR))
import env_manager


def load_json(path: Path) -> dict:
    return json.loads(path.read_text(encoding="utf-8"))


def load_json_yaml(path: Path) -> dict:
    return env_manager.load_json_yaml(path)


def write_json(path: Path, data: object) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--manifest", default=str(ROOT / "assets" / "official_attempt_manifest.yaml"))
    parser.add_argument("--out", default=str(ROOT / "result"))
    parser.add_argument("--example-id", default=None)
    args = parser.parse_args(argv)
    out = Path(args.out)
    manifest = load_json_yaml(Path(args.manifest))
    tutorial_catalog_path = ROOT / "references" / "tutorial_catalog.yaml"
    if not tutorial_catalog_path.exists():
        tutorial_catalog_path = ROOT / "references" / "examples_catalog.yaml"
    tutorial_catalog = load_json_yaml(tutorial_catalog_path) if tutorial_catalog_path.exists() else {}
    trace = load_json(ROOT / "references" / "tutorial_trace.json")
    dag_path = ROOT / "references" / "workflow_dag.json"
    dag = load_json(dag_path) if dag_path.exists() else {"nodes": [], "edges": []}
    steps = trace.get("workflow_steps", [])
    selected_example_id = args.example_id or (((manifest.get("inputs") or {}).get("algorithm") or {}).get("example_id")) or tutorial_catalog.get("default_example_id")
    plan = {
        "status": "planned",
        "example_id": selected_example_id,
        "tutorial_catalog": {
            "default_example_id": tutorial_catalog.get("default_example_id"),
            "selection_policy": tutorial_catalog.get("selection_policy"),
        },
        "manifest": env_manager.public_data(manifest),
        "steps": env_manager.public_data(steps),
        "workflow_dag": env_manager.public_data(dag),
        "evidence_used": [step.get("evidence_id") for step in steps],
    }
    write_json(out / "workflow" / "plan.json", plan)
    lines = ["# Workflow Plan", ""]
    for step in steps:
        lines.append("- `%s`: %s" % (step.get("id"), step.get("description", step.get("name"))))
    if dag.get("edges"):
        lines.append("")
        lines.append("## Dependencies")
        for edge in dag.get("edges", []):
            lines.append("- `%s` -> `%s` (%s)" % (edge.get("from"), edge.get("to"), edge.get("reason")))
    if not steps:
        lines.append("- No tutorial-confirmed steps.")
    (out / "workflow").mkdir(parents=True, exist_ok=True)
    (out / "workflow" / "plan.md").write_text("\n".join(lines) + "\n", encoding="utf-8")
    print(json.dumps({"status": "planned", "steps": len(steps)}, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
