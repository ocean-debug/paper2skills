from __future__ import annotations

import os
import shlex
import subprocess
import sys
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[2]
SCRIPT_DIR = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(SCRIPT_DIR))
import env_manager

EXECUTABLE_ADAPTER_STATUSES = {"verified"}


def adapter_spec() -> dict[str, Any]:
    return env_manager.load_json_yaml(ROOT / "references" / "adapter_spec.yaml")


def adapter_review() -> dict[str, Any]:
    path = ROOT / "references" / "adapter_review.yaml"
    if not path.exists():
        return {}
    return env_manager.load_json_yaml(path)


def examples_catalog() -> dict[str, Any]:
    path = ROOT / "references" / "tutorial_catalog.yaml"
    if not path.exists():
        path = ROOT / "references" / "examples_catalog.yaml"
    if not path.exists():
        return {}
    data = env_manager.load_json_yaml(path)
    return data if isinstance(data, dict) else {}


def selected_example(example_id: str | None) -> dict[str, Any]:
    catalog = examples_catalog()
    examples = catalog.get("examples") if isinstance(catalog.get("examples"), list) else []
    target = example_id or catalog.get("default_example_id")
    for item in examples:
        if isinstance(item, dict) and item.get("example_id") == target:
            return item
    return {}


def explicit_example_missing(example_id: str | None) -> bool:
    if not example_id:
        return False
    catalog = examples_catalog()
    examples = catalog.get("examples") if isinstance(catalog.get("examples"), list) else []
    return not selected_example(example_id)


def selected_adapter(example_id: str | None, spec: dict[str, Any]) -> dict[str, Any]:
    example = selected_example(example_id)
    adapter = example.get("adapter") if isinstance(example.get("adapter"), dict) else {}
    merged = dict(spec)
    merged.update({key: value for key, value in adapter.items() if value is not None})
    return merged


def selected_example_adapter_status(example_id: str | None, spec: dict[str, Any]) -> str:
    catalog = examples_catalog()
    examples = catalog.get("examples") if isinstance(catalog.get("examples"), list) else []
    if not examples:
        return str(spec.get("status") or "dry_run_only")
    adapter = selected_adapter(example_id, spec)
    return str(adapter.get("status") or "dry_run_only")


def command_tokens(value: Any) -> list[str]:
    if isinstance(value, list):
        return [str(item) for item in value if str(item)]
    if isinstance(value, str) and value.strip():
        try:
            return shlex.split(value, posix=os.name != "nt")
        except ValueError:
            return []
    return []


def expand_tokens(tokens: list[str], *, manifest_path: Path | None, out: Path, example_id: str | None = None) -> list[str]:
    replacements = {
        "{manifest}": str(manifest_path) if manifest_path else "",
        "{out}": str(out),
        "{root}": str(ROOT),
        "{example_id}": str(example_id or ""),
    }
    expanded = []
    for token in tokens:
        value = token
        for key, replacement in replacements.items():
            value = value.replace(key, replacement)
        if value:
            expanded.append(value)
    return expanded


def verified_outputs(example_id: str | None = None) -> list[str]:
    example = selected_example(example_id)
    contract = example.get("output_contract") if isinstance(example.get("output_contract"), dict) else {}
    required = contract.get("required_files") if isinstance(contract.get("required_files"), list) else None
    if required:
        return [str(item) for item in required if str(item)]
    expected = example.get("expected_outputs") if isinstance(example.get("expected_outputs"), list) else None
    if expected:
        return [str(item) for item in expected if str(item)]
    review = adapter_review()
    outputs = review.get("expected_outputs")
    if isinstance(outputs, list):
        return [str(item) for item in outputs if str(item)]
    return []


def working_dir() -> Path:
    source_root = ROOT / "sources" / "repo"
    return source_root if source_root.exists() else ROOT


def blocked(kind: str, message: str, spec: dict[str, Any]) -> dict[str, Any]:
    return {
        "status": "blocked",
        "adapter_type": kind,
        "adapter_status": spec.get("status"),
        "entrypoint": spec.get("entrypoint"),
        "command": env_manager.public_data(spec.get("command")),
        "message": message,
        "caveats": spec.get("caveats", []),
    }


def run_reviewed_command(kind: str, manifest: dict[str, Any], out: Path, manifest_path: Path | None = None, default_command: Any = None, example_id: str | None = None, verification_run: bool = False) -> dict[str, Any]:
    spec = adapter_spec()
    if explicit_example_missing(example_id):
        return {
            "status": "fail",
            "adapter_type": kind,
            "adapter_status": "dry_run_only",
            "example_id": example_id,
            "message": "Selected example is missing from tutorial_catalog.yaml.",
        }
    adapter = selected_adapter(example_id, spec)
    adapter_status = str(adapter.get("status") or "dry_run_only")
    if adapter_status not in EXECUTABLE_ADAPTER_STATUSES and not verification_run:
        return blocked(kind, "Adapter status is dry_run_only; verification must pass before real execution.", spec)
    command = adapter.get("command") or default_command
    tokens = expand_tokens(command_tokens(command), manifest_path=manifest_path, out=out, example_id=example_id)
    if not tokens:
        return blocked(kind, "Verified adapter command is missing.", spec)

    env = os.environ.copy()
    if manifest_path:
        env["PAPER2SKILL_MANIFEST"] = str(manifest_path)
    env["PAPER2SKILL_OUT"] = str(out)
    env["PAPER2SKILL_ROOT"] = str(ROOT)
    if example_id:
        env["PAPER2SKILL_EXAMPLE_ID"] = example_id

    log_dir = out / "logs"
    log_dir.mkdir(parents=True, exist_ok=True)
    completed = subprocess.run(tokens, cwd=working_dir(), env=env, text=True, capture_output=True, check=False)
    (log_dir / f"{kind}_adapter.stdout.log").write_text(completed.stdout or "", encoding="utf-8")
    (log_dir / f"{kind}_adapter.stderr.log").write_text(completed.stderr or "", encoding="utf-8")

    return {
        "status": "pass" if completed.returncode == 0 else "fail",
        "adapter_type": kind,
        "adapter_status": adapter_status,
        "global_adapter_status": spec.get("status"),
        "example_id": example_id,
        "entrypoint": adapter.get("entrypoint"),
        "command": env_manager.public_data(tokens),
        "returncode": completed.returncode,
        "outputs": verified_outputs(example_id),
        "message": "Verified adapter command executed." if completed.returncode == 0 else "Verified adapter command failed.",
    }
