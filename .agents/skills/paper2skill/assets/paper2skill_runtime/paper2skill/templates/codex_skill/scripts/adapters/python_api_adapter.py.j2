from __future__ import annotations

import importlib
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
SCRIPT_DIR = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(SCRIPT_DIR))
import env_manager

EXECUTABLE_ADAPTER_STATUSES = {"verified"}


def write_json(path: Path, data: object) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")


def input_path(manifest: dict) -> Path:
    value = ((manifest.get("inputs") or {}).get("primary_data") or {}).get("path")
    if not value:
        raise ValueError("inputs.primary_data.path is required")
    path = Path(value)
    return path if path.is_absolute() else ROOT / path


def examples_catalog() -> dict:
    path = ROOT / "references" / "tutorial_catalog.yaml"
    if not path.exists():
        path = ROOT / "references" / "examples_catalog.yaml"
    if not path.exists():
        return {}
    data = env_manager.load_json_yaml(path)
    return data if isinstance(data, dict) else {}


def selected_example(example_id: str | None) -> dict:
    catalog = examples_catalog()
    examples = catalog.get("examples") if isinstance(catalog.get("examples"), list) else []
    target = example_id or catalog.get("default_example_id")
    for item in examples:
        if isinstance(item, dict) and item.get("example_id") == target:
            return item
    return {}


def selected_adapter(example_id: str | None, spec: dict) -> dict:
    example = selected_example(example_id)
    adapter = example.get("adapter") if isinstance(example.get("adapter"), dict) else {}
    merged = dict(spec)
    merged.update({key: value for key, value in adapter.items() if value is not None})
    return merged


def run(manifest: dict, out: Path, manifest_path: Path | None = None, example_id: str | None = None, verification_run: bool = False) -> dict:
    spec = env_manager.load_json_yaml(ROOT / "references" / "adapter_spec.yaml")
    adapter = selected_adapter(example_id, spec)
    adapter_status = str(adapter.get("status") or "dry_run_only")
    if adapter_status not in EXECUTABLE_ADAPTER_STATUSES and not verification_run:
        return {
            "status": "blocked",
            "adapter_type": "python_api",
            "adapter_status": adapter_status,
            "global_adapter_status": spec.get("status"),
            "example_id": example_id,
            "entrypoint": adapter.get("entrypoint"),
            "message": "Python API adapter is dry_run_only; verification must pass before real execution.",
            "caveats": spec.get("caveats", []),
        }
    source_root = ROOT / "sources" / "repo"
    if source_root.exists():
        sys.path.insert(0, str(source_root))
    module_name = adapter.get("module")
    function_name = adapter.get("function")
    if not module_name or not function_name:
        return {
            "status": "blocked",
            "adapter_type": "python_api",
            "adapter_status": adapter_status,
            "global_adapter_status": spec.get("status"),
            "example_id": example_id,
            "entrypoint": adapter.get("entrypoint"),
            "message": "Python API adapter is missing module/function wiring.",
            "caveats": spec.get("caveats", []),
        }
    module = importlib.import_module(module_name)
    function = getattr(module, function_name)
    result = function(input_path(manifest))
    output_path = out / "results" / "summary.json"
    write_json(output_path, env_manager.public_data(result))
    return {
        "status": "pass",
        "adapter_type": "python_api",
        "adapter_status": adapter_status,
        "global_adapter_status": spec.get("status"),
        "example_id": example_id,
        "entrypoint": adapter.get("entrypoint"),
        "outputs": ["results/summary.json"],
        "message": "Python API adapter executed.",
    }
