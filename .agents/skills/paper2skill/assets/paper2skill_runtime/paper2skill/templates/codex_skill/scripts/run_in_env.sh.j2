#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENV_NAME="${PAPER2SKILL_ENV_NAME:-{{ skill_name }}-env}"
ENV_PREFIX="${PAPER2SKILL_ENV_PREFIX:-}"
MANIFEST="${1:-$ROOT/assets/demo_input_manifest.yaml}"
OUT="${2:-$ROOT/result}"

if [ -n "${CONDA_SH:-}" ] && [ -f "$CONDA_SH" ]; then
  # shellcheck source=/dev/null
  set +u
  source "$CONDA_SH"
  if [ -n "$ENV_PREFIX" ]; then
    conda activate "$ENV_PREFIX"
  else
    conda activate "$ENV_NAME"
  fi
  set -u
  python "$ROOT/scripts/run.py" --manifest "$MANIFEST" --out "$OUT"
  exit $?
fi

if command -v conda >/dev/null 2>&1; then
  if [ -n "$ENV_PREFIX" ]; then
    conda run -p "$ENV_PREFIX" python "$ROOT/scripts/run.py" --manifest "$MANIFEST" --out "$OUT"
    exit $?
  fi
  conda run -n "$ENV_NAME" python "$ROOT/scripts/run.py" --manifest "$MANIFEST" --out "$OUT"
  exit $?
fi

echo "conda is required; set CONDA_SH or put conda on PATH" >&2
exit 2
