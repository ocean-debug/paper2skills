      "source": [
        "# Minimal tutorial\n",
        "\n",
        "Load a single-cell matrix, normalize it, and write results."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "import scanpy as sc\n",
        "adata = sc.read_10x_mtx('data/filtered_feature_bc_matrix')\n",
        "sc.pp.normalize_total(adata)\n",
        "sc.pp.log1p(adata)\n",
        "adata.write_h5ad('results/minimal_output.h5ad')\n"
      ]
    }
  ],
  "metadata": {},
  "nbformat": 4,
  "nbformat_minor": 5
}
